    },
    "This new order would be a fourth active order. Upgrade to Keyvow Pro for unlimited active orders, or resolve an existing order before saving. Delivered, cancelled, and fully refunded orders do not count toward the limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
