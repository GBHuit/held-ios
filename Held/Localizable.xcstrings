            "state": "translated",
            "value": "键诺 Pro"
          }
        }
      }
    },
    "One lifetime upgrade. Unlimited active orders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One lifetime upgrade. Unlimited active orders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次升级，终身使用。进行中订单不限数量。"
