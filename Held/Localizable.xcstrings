        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text recognition and field extraction can be wrong, especially for product names, sellers, delivery wording, currencies, dates, and similar-looking characters. Confidence is a heuristic hint, not certainty. Review every suggestion and its source line before using it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本识别和字段提取可能有误，尤其是产品名称、卖家、交付措辞、货币、日期和形近字符。置信度仅为启发式提示，并非确定结果。使用每条建议前，请核对其内容及来源行。"
          }
        }
      }
    },
    "Text recognition could not read this image. %@ You can continue manually.": {
