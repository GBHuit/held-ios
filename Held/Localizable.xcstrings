        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义截止日期仅用于整理事项，并不代表支付保护决定。请向支付服务商核实当前规则；键诺不判定资格、不发起争议，也不保证追回款项。"
          }
