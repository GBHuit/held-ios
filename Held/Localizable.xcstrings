    },
    "This deletes the %lld order currently in Keyvow and replaces it with this backup. Unreferenced evidence files may also be removed after a successful restore. Keep another backup if you may need the current data later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the %lld order currently in Keyvow and replaces it with this backup. Unreferenced evidence files may also be removed after a successful restore. Keep another backup if you may need the current data later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除键诺中当前的 %lld 个订单，并替换为此备份。成功恢复后，未被引用的证据文件也可能移除。若以后可能需要当前数据，请保留另一份备份。"
          }
        }
      }
    },
    "This deletes the %lld orders currently in Keyvow and replaces them with this backup. Unreferenced evidence files may also be removed after a successful restore. Keep another backup if you may need the current data later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
