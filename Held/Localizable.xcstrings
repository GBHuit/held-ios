      }
    },
    "The stale threshold affects attention cues. Default lead time is for newly created reminders; existing reminders keep their own dates. With order reminders enabled, the digest arrives each Monday at 9:00 AM with active-order and attention counts. It uses local notifications, not a server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stale threshold affects attention cues. Default lead time is for newly created reminders; existing reminders keep their own dates. With order reminders enabled, the digest arrives each Monday at 9:00 AM with active-order and attention counts. It uses local notifications, not a server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "久未更新阈值会影响关注提示。默认提前时间仅用于新建提醒，现有提醒保留各自日期。开启订单提醒后，每周一上午 9:00 会收到包含进行中订单和需关注数量的摘要。摘要使用本地通知，不经过服务器。"
          }
        }
      }
    },
    "Keyvow Pro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyvow Pro"
          }
        },
        "zh-Hans": {
