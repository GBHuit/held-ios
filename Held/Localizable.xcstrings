    "The authorization prompt appears only when you turn reminders on. Turning reminders off removes Keyvow’s pending order notifications; it does not change iOS permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The authorization prompt appears only when you turn reminders on. Turning reminders off removes Keyvow’s pending order notifications; it does not change iOS permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有开启提醒时才会显示授权提示。关闭提醒会移除键诺待发送的订单通知，但不会更改 iOS 权限。"
