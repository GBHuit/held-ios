          }
        }
      }
    },
    "This CSV contains order, payment, source URL, notes, tracking, and line-item details. Sharing it can expose private purchase information.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This CSV contains order, payment, source URL, notes, tracking, and line-item details. Sharing it can expose private purchase information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 CSV 包含订单、支付、来源 URL、备注、物流和商品明细。分享可能暴露私人购买信息。"
          }
        }
      }
    },
    "This JSON contains order, payment, source URL, notes, tracking, reminder, evidence metadata, and app settings. Sharing it can expose private purchase and dispute information.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This JSON contains order, payment, source URL, notes, tracking, reminder, evidence metadata, and app settings. Sharing it can expose private purchase and dispute information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 JSON 包含订单、支付、来源 URL、备注、物流、提醒、证据元数据和 App 设置。分享可能暴露私人购买和争议信息。"
          }
        }
      }
    },
    "This JSON contains records only. Evidence metadata is restored, but unavailable local file references are cleared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This JSON contains records only. Evidence metadata is restored, but unavailable local file references are cleared."
          }
