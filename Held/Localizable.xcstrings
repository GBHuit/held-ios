          }
        }
      }
    },
    "This ZIP contains order, payment, source, and evidence metadata together with original attachment files. Treat it as sensitive private data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ZIP contains order, payment, source, and evidence metadata together with original attachment files. Treat it as sensitive private data."
