{
  "sourceLanguage": "en",
  "strings": {
    "Add to Keyvow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Keyvow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到键诺"
          }
        }
      }
    },
    "Keyvow could not open its shared local inbox. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyvow could not open its shared local inbox. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键诺无法打开共享本地收件箱，请重试。"
          }
        }
      }
    },
    "Queue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入队列"
          }
        }
      }
    },
    "Reading shared content…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading shared content…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取分享内容…"
          }
        }
      }
    },
    "Share an https link or some text to add it to Keyvow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share an https link or some text to add it to Keyvow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享 https 链接或一些文本，即可添加到键诺。"
          }
        }
      }
    },
    "Shared with Keyvow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared with Keyvow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享给键诺"
          }
        }
      }
    },
    "The shared item could not be queued. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared item could not be queued. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将分享项目加入队列。%@"
          }
        }
      }
    },
    "This queues the shared details on this device. You will review them before creating an order in Keyvow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This queues the shared details on this device. You will review them before creating an order in Keyvow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将分享详情加入此设备的待处理队列。创建键诺订单前，你还需要核对内容。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    }
  },
  "version": "1.0"
